rules_version = '2';

// Cloud Firestore security rules enforcing least-privilege document isolation,
// role locking, data minimisation, and immutable audit logging.

service cloud.firestore {
  match /databases/{database}/documents {

    // ---- HELPER FUNCTIONS ----
    function isSignedIn() {
      return request.auth != null;
    }

    function isAdmin() {
      return isSignedIn()
        && exists(/databases/$(database)/documents/users/$(request.auth.uid)) /* [1] */
        && get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role == 'admin';
    }

    // ---- 1. ROOT USERS COLLECTION ----
    // User profile records.
    match /users/{uid} {
      allow read: if isAdmin() || (isSignedIn() && request.auth.uid == uid);

      // A new user may create only their own record, as a non-admin, active account.
      allow create: if isSignedIn() && request.auth.uid == uid
                    && request.resource.data.role == 'user'   /* [2] */
                    && request.resource.data.active == true;  /* [2] */

      // Only admins can change roles; users may delete their own account (GDPR erasure).
      allow update: if isAdmin(); /* [3] */
      allow delete: if isAdmin() || (isSignedIn() && request.auth.uid == uid); /* [3] */

      // Messages: the user reads their own; only an admin creates them.
      match /messages/{messageId} {
        allow read: if isSignedIn() && request.auth.uid == uid;
        // Created by an admin (to any user) or by the user's own session (welcome message at sign-up).
        allow create: if isAdmin() || (isSignedIn() && request.auth.uid == uid);
        allow delete: if isAdmin() || (isSignedIn() && request.auth.uid == uid); /* [4] */
      }
    }

    // ---- 2. USER PROGRESS COLLECTION ----
    // Each user reads/writes only their own progress.
    match /progress/{uid} {
      allow read, write: if isSignedIn() && request.auth.uid == uid; /* [5] */
    }

    // ---- 3. GUIDES COLLECTION ----
    // Guide content overrides: anyone may read; only admins may edit.
    match /guides/{slug} {
      allow read: if true;
      allow write: if isAdmin();
    }

    // ---- 4. PHYSICAL SUPPORT MARKERS COLLECTION ----
    // Service-point markers: anyone may read; only admins may edit.
    match /markers/{id} {
      allow read: if true;
      allow write: if isAdmin();
    }

    // ---- 5. IMMUTABLE ADMINISTRATIVE AUDIT LOGS ----
    // Audit log of admin actions (admin-only).
    match /adminLogs/{logId} {
      allow read, create: if isAdmin(); /* [6] */
    }
  }
}
