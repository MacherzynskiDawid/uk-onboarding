rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    function isSignedIn() {
      return request.auth != null;
    }
    function isAdmin() {
      return isSignedIn()
        && exists(/databases/$(database)/documents/users/$(request.auth.uid))
        && get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role == 'admin';
    }

    // User profile records.
    match /users/{uid} {
      allow read: if isAdmin() || (isSignedIn() && request.auth.uid == uid);
      // A new user may create only their own record, as a non-admin, active account.
      allow create: if isSignedIn() && request.auth.uid == uid
                    && request.resource.data.role == 'user'
                    && request.resource.data.active == true;
      // Only admins can change roles or deactivate accounts.
      allow update, delete: if isAdmin();

      // Messages: the user reads their own; only an admin creates them.
      match /messages/{messageId} {
        allow read: if isSignedIn() && request.auth.uid == uid;
        // Created by an admin (to any user) or by the user's own session (welcome message at sign-up).
        allow create: if isAdmin() || (isSignedIn() && request.auth.uid == uid);
      }
    }

    // Each user reads/writes only their own progress.
    match /progress/{uid} {
      allow read, write: if isSignedIn() && request.auth.uid == uid;
    }

    // Guide content overrides: anyone may read; only admins may edit.
    match /guides/{slug} {
      allow read: if true;
      allow write: if isAdmin();
    }

    // Audit log of admin actions (admin-only).
    match /adminLogs/{logId} {
      allow read, create: if isAdmin();
    }
  }
}
